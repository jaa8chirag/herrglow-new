# Copy to .env on the server (chmod 600). NEVER commit the real file.
# ── stack ──
COMPOSE_PROJECT_NAME=herrglow
DOMAIN=herrglow.com
CADDYFILE=./Caddyfile
POSTGRES_PASSWORD=change-me-long-random

# ── site ──
SITE_URL=https://herrglow.com
AUTH_SECRET=generate-with-openssl-rand-base64-32
# production only. Staging MUST keep this false.
ALLOW_INDEXING=true
# makes the build test fail if production would be noindex
DEPLOY_ENV=production
# baked into the client bundle at build time (one image per environment)
NEXT_PUBLIC_CF_RESIZING=true

# ── media (Cloudflare R2). Required in production: uploads are stored there ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=herrglow-media
MEDIA_BASE=https://media.herrglow.com

# ── backups ──
BACKUP_BUCKET=herrglow-backups
BACKUP_RETENTION_DAYS=30

# ── notifications ──
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HerrGlow <no-reply@herrglow.com>"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ── staging only ──
# STAGING_USER=herrglow
# STAGING_PASSWORD_HASH=   (caddy hash-password output)
