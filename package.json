{
  "name": "herrglow",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "dev:web": "pnpm --filter @herrglow/web dev",
    "dev:worker": "pnpm --filter @herrglow/worker dev",
    "db:migrate": "pnpm --filter @herrglow/db migrate",
    "db:generate": "pnpm --filter @herrglow/db generate",
    "db:seed": "pnpm --filter @herrglow/db seed:dev",
    "import:legacy": "pnpm --filter @herrglow/db import:legacy",
    "typecheck": "pnpm -r run typecheck",
    "import:media": "tsx scripts/import-legacy-media.ts",
    "shots": "tsx scripts/screenshots.ts"
  },
  "devDependencies": {
    "@herrglow/core": "workspace:*",
    "@herrglow/db": "workspace:*",
    "lighthouse": "^13.6.0",
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15"
  },
  "type": "module"
}
