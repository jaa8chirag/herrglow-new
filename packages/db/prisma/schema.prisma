generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────
enum Status {
  ACTIVE
  INACTIVE
}
enum ProStatus {
  PENDING
  ACTIVE
  INACTIVE
}
enum ProviderType {
  BEAUTICIAN
  MAKEOVER_ARTIST
  BOTH
}
enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  QUOTED
  BOOKED
  COMPLETED
  LOST
}
enum PageType {
  HOME
  CATEGORY
  SERVICE
  CITY
  SERVICE_CITY
  AREA
  PRO
  BLOG
  STATIC
}
enum RedirectCode {
  MOVED_301
  GONE_410
}
enum AdminRole {
  OWNER
  MANAGER
  SUPPORT
  CONTENT
}
enum MediaType {
  IMAGE
  VIDEO
  YOUTUBE
}

// ───────── Catalog ─────────
model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  sort     Int       @default(0)
  services Service[]
}

model Service {
  id               String   @id @default(cuid())
  legacyId         Int?     @unique
  slug             String   @unique
  title            String
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  providerType     ProviderType @default(BOTH)
  shortDescription String?
  description      String?
  features         String?
  price            Decimal? @db.Decimal(10, 2)
  offerPrice       Decimal? @db.Decimal(10, 2)
  priceLabel       String?
  duration         String?
  image            String?
  imageAlt         String?
  seoTitle         String?
  seoDescription   String?
  faqs             Json?
  featured         Boolean  @default(false)
  sort             Int      @default(0)
  status           Status   @default(ACTIVE)
  // set when merged into another service (drives 301)
  mergedIntoId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cities    ServiceCity[]
  pros      ProService[]
  leads     LeadService[]
  packages  PackageService[]
}

model Package {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String?
  description      String?
  price            Decimal? @db.Decimal(10, 2)
  offerPrice       Decimal? @db.Decimal(10, 2)
  duration         String?
  image            String?
  status           Status   @default(ACTIVE)
  services         PackageService[]
  leads            Lead[]
}

model PackageService {
  packageId String
  serviceId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([packageId, serviceId])
}

// ───────── Locations ─────────
model City {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  state       String?
  // a city gets public pages only when it has enough active pros (see core/seo)
  isLaunched  Boolean @default(false)
  seoTitle    String?
  seoDescription String?
  content     String?
  faqs        Json?
  areas       Area[]
  services    ServiceCity[]
}

model Area {
  id            String  @id @default(cuid())
  legacyId      Int?    @unique
  citySlug      String
  city          City    @relation(fields: [citySlug], references: [slug])
  slug          String  @unique
  name          String
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  radiusKm      Decimal? @db.Decimal(5, 2)
  sector        String?
  zone          String?
  pincodes      String[]
  landmarks     String[]
  content       String?
  faqs          Json?
  seoTitle      String?
  seoDescription String?
  showOnHome    Boolean @default(false)
  status        Status  @default(ACTIVE)
  coverage      ProCoverage[]
  nearby        AreaNearby[] @relation("from")
  nearbyOf      AreaNearby[] @relation("to")
}

/// Directional "nearby areas" (legacy nearby_location_ids)
model AreaNearby {
  areaId   String
  nearbyId String
  area     Area @relation("from", fields: [areaId], references: [id], onDelete: Cascade)
  nearby   Area @relation("to", fields: [nearbyId], references: [id], onDelete: Cascade)
  @@id([areaId, nearbyId])
}

/// Replaces legacy location_service (24k rows): availability + price per service per CITY.
model ServiceCity {
  serviceId     String
  cityId        String
  priceOverride Decimal? @db.Decimal(10, 2)
  localContent  String?
  active        Boolean  @default(true)
  service       Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  city          City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  @@id([serviceId, cityId])
}

// ───────── Pros ─────────
model Pro {
  id            String  @id @default(cuid())
  legacyId      Int?    @unique
  legacySlug    String?
  slug          String  @unique
  name          String
  providerType  ProviderType @default(BOTH)
  photo         String?
  /// [{ path, alt }]
  portfolio     Json?
  youtubeUrls   String[]
  experienceYears Int?
  specialization  String?
  bio           String?
  basePrice     Decimal? @db.Decimal(10, 2)
  dailyLeadViewLimit   Int @default(10)
  weeklyLeadViewLimit  Int @default(50)
  monthlyLeadViewLimit Int @default(200)
  status        ProStatus @default(PENDING)
  seoTitle      String?
  seoDescription String?
  createdAt     DateTime @default(now())

  /// PRIVATE: never include in public pages or the public API. Only admin/core-internal code may touch this relation.
  private   ProPrivate?
  services  ProService[]
  coverage  ProCoverage[]
  leads     Lead[]
}

/// Contact + internal data, deliberately a separate table so a public query can never return it by accident.
model ProPrivate {
  proId        String  @id
  pro          Pro     @relation(fields: [proId], references: [id], onDelete: Cascade)
  phone        String?
  email        String?
  addressLine  String?
  landmark     String?
  pincode      String?
  serviceAreasText String?
  referralCode String? @unique
  referredById String?
}

model ProService {
  proId     String
  serviceId String
  price     Decimal? @db.Decimal(10, 2)
  pro       Pro     @relation(fields: [proId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([proId, serviceId])
}

/// pro × area × price → decides serviceability
model ProCoverage {
  proId      String
  areaId     String
  price      Decimal? @db.Decimal(10, 2)
  priceLabel String?
  pro        Pro  @relation(fields: [proId], references: [id], onDelete: Cascade)
  area       Area @relation(fields: [areaId], references: [id], onDelete: Cascade)
  @@id([proId, areaId])
}

// ───────── Leads / customers ─────────
model Customer {
  id        String  @id @default(cuid())
  phone     String  @unique
  name      String?
  email     String?
  createdAt DateTime @default(now())
  leads     Lead[]
}

model Lead {
  id          String     @id @default(cuid())
  legacyId    Int?       @unique
  bookingRef  String?    @unique
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  name        String
  phone       String
  email       String?
  proId       String?
  pro         Pro?       @relation(fields: [proId], references: [id])
  packageId   String?
  package     Package?   @relation(fields: [packageId], references: [id])
  // location is free text in legacy; areaId filled where it can be matched
  locationText String?
  areaId       String?
  address     String?
  latitude    Decimal?   @db.Decimal(10, 7)
  longitude   Decimal?   @db.Decimal(10, 7)
  eventDate   DateTime?  @db.Date
  timeSlot    String?
  guestCount  Int?
  venue       String?
  budget      Decimal?   @db.Decimal(10, 2)
  message     String?
  source      String     @default("website")
  sourceUrl   String?
  status      LeadStatus @default(NEW)
  paymentStatus String   @default("pending")
  amount      Decimal?   @db.Decimal(10, 2)
  discount    Decimal?   @db.Decimal(10, 2)
  finalAmount Decimal?   @db.Decimal(10, 2)
  adminNote   String?
  meta        Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  services LeadService[]
  @@index([status, createdAt])
}

model LeadService {
  leadId    String
  serviceId String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id])
  @@id([leadId, serviceId])
}

// ───────── Content ─────────
model Blog {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  image          String?
  imageAlt       String?
  excerpt        String?
  content        String?
  authorName     String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  status         Status   @default(ACTIVE)
  publishedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Testimonial {
  id          String @id @default(cuid())
  name        String
  photo       String?
  location    String?
  serviceName String?
  rating      Int    @default(5)
  review      String
  status      Status @default(ACTIVE)
  sort        Int    @default(0)
}

model GalleryItem {
  id        String    @id @default(cuid())
  title     String
  mediaType MediaType @default(IMAGE)
  mediaPath String?
  thumbnail String?
  youtubeId String?
  alt       String?
  category  String?
  status    Status    @default(ACTIVE)
  sort      Int       @default(0)
}

model SiteSetting {
  key   String  @id
  value String?
}

// ───────── SEO control ─────────
model Page {
  id            String   @id @default(cuid())
  url           String   @unique
  type          PageType
  entityId      String?
  qualityScore  Int      @default(0)
  isIndexable   Boolean  @default(false)
  inSitemap     Boolean  @default(false)
  canonicalUrl  String?
  seoTitle      String?
  seoDescription String?
  lastmod       DateTime @default(now())
  inLinks       Int      @default(0)
  outLinks      Int      @default(0)
}

model Redirect {
  fromPath  String       @id
  toPath    String?
  code      RedirectCode @default(MOVED_301)
  note      String?
}

// ───────── Admin auth (Auth.js credentials) ─────────
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  role         AdminRole @default(SUPPORT)
  createdAt    DateTime  @default(now())
}
